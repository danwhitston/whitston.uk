---
import BaseHead from '../components/BaseHead.astro';
import Currently from '../components/Currently.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { profile, SITE_URL } from '../config/profile';

// Deliberately no post list. The archive is reachable from the footer, and the
// line framing it lives on /blog/ instead.

// JSON-LD Person: how Google connects a search for the name to this site.
// Every value comes from src/config/profile.ts so it cannot drift from the copy.
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	jobTitle: profile.jobTitle,
	...(profile.worksFor && {
		worksFor: { '@type': 'Organization', name: profile.worksFor.name, url: profile.worksFor.url },
	}),
	url: SITE_URL,
	address: {
		'@type': 'PostalAddress',
		addressLocality: profile.location.locality,
		addressCountry: profile.location.country,
	},
	sameAs: [profile.links.linkedin, profile.links.github],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={profile.name} description={profile.strapline} />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
		<style>
			main {
				width: 720px;
			}
			h1 {
				margin-bottom: 0.2em;
			}
			.strapline {
				font-size: 1.2rem;
				line-height: 1.5;
				color: rgb(var(--gray-dark));
				margin-bottom: 2.5rem;
			}
			.contact {
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			@media (max-width: 720px) {
				.strapline {
					font-size: 1.05rem;
					margin-bottom: 1.75rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{profile.name}</h1>
			<p class="strapline">{profile.strapline}</p>

			<Currently />

			<p class="contact">
				More on the <a href="/about/">about page</a>, or reach me at <a href={`mailto:${profile.email}`}>{profile.email}</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
