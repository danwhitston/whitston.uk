---
import BaseHead from '../components/BaseHead.astro';
import Currently from '../components/Currently.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// Deliberately no post list. The archive is reachable from the footer, and the
// line framing it lives on /blog/ instead.

// JSON-LD Person: how Google connects a search for the name to this
// site. Keep `sameAs` in step with the links in Header.astro.
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Daniel Whitston',
	jobTitle: 'CTO',
	worksFor: { '@type': 'Organization', name: 'AutogenAI', url: 'https://autogenai.com' },
	url: 'https://whitston.uk',
	address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
	sameAs: ['https://www.linkedin.com/in/danielwhitston', 'https://github.com/danwhitston'],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
		<style>
			main {
				width: 720px;
			}
			h1 {
				margin-bottom: 0.2em;
			}
			.strapline {
				font-size: 1.2rem;
				line-height: 1.5;
				color: rgb(var(--gray-dark));
				margin-bottom: 2.5rem;
			}
			.contact {
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			@media (max-width: 720px) {
				.strapline {
					font-size: 1.05rem;
					margin-bottom: 1.75rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Daniel Whitston</h1>
			<p class="strapline">
				Founding CTO at AutogenAI. Shipped a production LLM product before ChatGPT launched; the
				architecture has survived four model generations since. London.
			</p>

			<Currently />

			<p class="contact">
				More on the <a href="/about/">about page</a>, or reach me at <a
					href="mailto:dan@whitston.uk">dan@whitston.uk</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
